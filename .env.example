# Claude API Key (from https://console.anthropic.com)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google AI Studio API Key (from https://aistudio.google.com/app/apikey)
GOOGLE_AI_API_KEY=your_google_ai_api_key_here

# OpenAI API Key (from https://platform.openai.com/api-keys) — used for gpt-image-2
OPENAI_API_KEY=your_openai_api_key_here

# Server port (optional, defaults to 3001)
PORT=3001

# Ziel des Vite-Proxys im Dev-Betrieb (optional, sonst 3001). Setzen, wenn auf
# 3001 schon ein anderes Projekt läuft — dann PORT und API_PORT gleich setzen.
# API_PORT=3002

# ── Wer schreibt den Prompt? (optional) ─────────────────────────────────────
# Voreinstellung: Gemini — kostenloses Kontingent, und für den strukturierten
# Prompt reicht es, weil Schema und Rollen vollständig im Auftrag stehen.
# Auf claude umstellen, wenn ein Auftrag mehr Urteilskraft braucht.
# PROMPT_ANBIETER=gemini
#
# ── Tempo, falls PROMPT_ANBIETER=claude (beides optional) ──────────────────
# ANALYZE_EFFORT: wie gründlich der Prompt-Schreiber nachdenkt.
#   low    — am schnellsten, für einfache Aufträge
#   medium — Voreinstellung, guter Kompromiss
#   high / xhigh / max — gründlicher, dauert spürbar länger
# ANALYZE_EFFORT=medium
#
# ANALYZE_MODEL: Erstwahl des Modells. Ohne Angabe claude-sonnet-5, mit
# claude-opus-5 als Rückfall bei Überlastung. Auf claude-opus-5 setzen, wenn
# ein Auftrag mehr Urteilskraft braucht — dauert dann wieder länger.
# ANALYZE_MODEL=claude-sonnet-5

# ── Auth (only set on Vercel — leave empty for local dev) ───────────────────
# Generate both with: npm run hash-password
# AUTH_USERS: JSON array of { email, hash } pairs. Hashes are scrypt strings.
# AUTH_SECRET: random secret used to sign session cookies. Min 32 chars.
# If either is empty, auth is disabled (every request passes through).
AUTH_USERS=
AUTH_SECRET=
